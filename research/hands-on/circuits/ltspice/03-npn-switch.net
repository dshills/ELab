VIN IN 0 PULSE(0 5 0 1u 1u 50m 100m)
VCC N001 0 5
RB IN BASE 10k
RC N001 OUT 1k
Q1 OUT BASE 0 0 QGEN
.model NPN NPN
.model PNP PNP
.lib C:\users\crossover\AppData\Local\LTspice\lib\cmp\standard.bjt
.model QGEN NPN(Is=1e-14 Bf=100)
.tran 0 200m 0 10u
.meas tran von FIND V(OUT) AT=25m
.meas tran voff FIND V(OUT) AT=75m
.backanno
.end
