+		return root
+	})
+	unitSettle(t, m)
+	w := m.implementation.find("one").state
+	window, control := imageManualElement(t, m, "number")
+	point := image.Pt(control.Bounds.Min.X+20, control.Bounds.Min.Y+control.Bounds.Dy()/2)
