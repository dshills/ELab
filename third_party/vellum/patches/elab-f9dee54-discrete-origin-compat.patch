+				unitSettle(t, m)
+			}
+			input(events.MouseDown, position(.5))
+			input(events.MouseMove, position(.7))
+			if fraction != .5 {
+				t.Fatal("test unexpectedly entered timed sliding", fraction)
+			}
+			input(events.MouseUp, position(.8))
+			if math.Abs(float64(fraction-.8)) > .015 {
+				t.Fatal("release position lost", fraction)
+			}
+		})
+	}
+}
