+		{"upper-wrap", .031, .001, .0315, .001, []key.Codes{key.CodeUpArrow}, []float32{.001}, []string{"0.001"}},
+		{"lower-wrap", .001, .001, .0315, .001, []key.Codes{key.CodeDownArrow}, []float32{.0315}, []string{"0.0315"}},
+		{"tight-bound", 1.989999, 0, 1.999999, .01, []key.Codes{key.CodeUpArrow, key.CodeUpArrow}, []float32{1.999999, 0}, []string{"1.999999", "0"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			number, calls := tc.value, 0
+			m, _ := simpleManual(t, manualConfig(t, 7), func() ui.Node {
+				return ui.Node{ID: "root", Kind: ui.Column, Focus: ui.FocusRequest{ID: "number", Sequence: 1}, Children: []ui.Node{
+					{ID: "number", Kind: ui.NumberField, Number: number, Numeric: ui.Numeric{Min: tc.minimum, Max: tc.maximum, Step: tc.step}, Change: func(e ui.ChangeEvent) { number = e.Number; calls++ }},
+				}}
+			})
+			unitSettle(t, m)
+			w := m.implementation.find("one")
+			spinner := findRecord(w.state.root, "number").widget.(*core.Spinner)
+			for i, code := range tc.keys {
+				if err := m.Input(testContext, ManualInput{Window: "one", WindowIncarnation: w.incarnation, Type: events.KeyChord, Code: code}); err != nil {
