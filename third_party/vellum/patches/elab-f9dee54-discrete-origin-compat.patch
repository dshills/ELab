@@ -0,0 +1,90 @@
+//go:build offscreen
+
+package cogent
+
+import (
+	"fmt"
+	"testing"
+
+	"cogentcore.org/core/core"
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+	"cogentcore.org/core/math32"
+	"github.com/dshills/vellum/ui"
+)
+
+func TestSliderWheelPreservesValueAndScrollsParent(t *testing.T) {
+	for _, scrolling := range []bool{false, true} {
+		for _, focused := range []bool{false, true} {
+			t.Run(fmt.Sprintf("scroll-parent=%t/focused=%t", scrolling, focused), func(t *testing.T) {
+				value, calls := float32(25), 0
+				focus := "neutral"
+				if focused {
+					focus = "slider"
+				}
+				m, _ := simpleManual(t, manualConfig(t, 7), func() ui.Node {
+					children := []ui.Node{
+						{ID: "slider", Kind: ui.Slider, Number: value, MinHeight: 40, Numeric: ui.Numeric{Min: 0, Max: 100, Step: 1}, Change: func(e ui.ChangeEvent) { value = e.Number; calls++ }},
+						{ID: "witness", Kind: ui.Label, Text: "Following controls", MinHeight: 32},
+					}
+					if scrolling {
+						for i := range 16 {
+							children = append(children, ui.Node{ID: fmt.Sprintf("padding-%d", i), Kind: ui.Label, Text: "Further controls", MinHeight: 32})
+						}
+						children = []ui.Node{{ID: "scroll", Kind: ui.Scroll, Grow: true, Children: []ui.Node{{ID: "content", Kind: ui.Column, Children: children}}}}
+					}
+					return ui.Node{ID: "root", Kind: ui.Column, Grow: true, Focus: ui.FocusRequest{ID: focus, Sequence: 1}, Children: append([]ui.Node{{ID: "neutral", Kind: ui.Button, Text: "Outside the slider", Activate: func() {}}}, children...)}
+				})
+				unitSettle(t, m)
+				w := m.implementation.find("one")
+				send := func(input ManualInput) {
+					t.Helper()
+					input.Window, input.WindowIncarnation = "one", w.incarnation
+					if err := m.Input(testContext, input); err != nil {
+						t.Fatal(err)
+					}
+					unitSettle(t, m)
+				}
+				snapshot, err := m.Snapshot(testContext)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if snapshot.Windows[0].FocusedID != focus {
+					t.Fatal("fixture did not establish actual focus", snapshot.Windows[0].FocusedID)
+				}
+				slider := findRecord(w.state.root, "slider").widget.(*core.Slider)
+				before := findRecord(w.state.root, "witness").widget.AsWidget().Geom.TotalBBox
+				box := slider.Geom.TotalBBox
+				send(ManualInput{Type: events.Scroll, Position: box.Min.Add(box.Size().Div(2)), Delta: math32.Vec2(0, 12)})
+				if value != 25 || slider.Value != 25 || calls != 0 {
+					t.Fatal("wheel changed the accepted slider value", value, slider.Value, calls)
+				}
+				if scrolling {
+					after := findRecord(w.state.root, "witness").widget.AsWidget().Geom.TotalBBox
+					if after.Min.Y >= before.Min.Y {
+						t.Fatal("wheel did not reach the enclosing pane", before, after)
+					}
+				}
+				if focused {
+					send(ManualInput{Type: events.KeyChord, Code: key.CodeRightArrow})
+					if value != 26 || calls != 1 {
+						t.Fatal("Right did not increment exactly once", value, calls)
+					}
+					send(ManualInput{Type: events.KeyChord, Code: key.CodeLeftArrow})
+					if value != 25 || calls != 2 {
+						t.Fatal("Left did not decrement exactly once", value, calls)
+					}
+				}
+				// Pointer changes remain deliberate and commit once on release.
+				beforeCalls := calls
+				box = slider.Geom.TotalBBox
+				point := box.Min.Add(box.Size().Div(2))
+				send(ManualInput{Type: events.MouseDown, Button: events.Left, Position: point})
+				send(ManualInput{Type: events.MouseUp, Button: events.Left, Position: point})
+				if value == 25 || calls != beforeCalls+1 {
+					t.Fatal("pointer click lost its single deliberate commit", value, calls-beforeCalls)
+				}
+			})
+		}
+	}
+}
