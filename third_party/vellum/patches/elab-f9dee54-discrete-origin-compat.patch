+		{"off-grid", .0305, 0, 1, .001, []key.Codes{key.CodeUpArrow, key.CodeDownArrow}, []float32{.0315, .0305}, []string{"0.0315", "0.0305"}},
+		{"negative", -.03, -1, 1, .001, []key.Codes{key.CodeDownArrow, key.CodeDownArrow, key.CodeUpArrow}, []float32{-.031, -.032, -.031}, []string{"-0.031", "-0.032", "-0.031"}},
