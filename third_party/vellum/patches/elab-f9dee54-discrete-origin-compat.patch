++	drainManual(t, m)
++	if em.longHoverTimer != nil || em.longHoverWidget != nil {
++		t.Fatal("scroll did not retire pending hover")
++	}
++	move()
++	current := em.longHoverTimer
++	if current == nil || em.longHoverWidget != field {
++		t.Fatal("new hover was not armed")
++	}
++	body.AsyncLock()
++	old()
++	body.AsyncUnlock()
++	drainManual(t, m)
++	if em.longHoverTimer != current || em.longHoverWidget != field {
++		t.Fatal("old callback replaced the new session")
++	}
++	if p := inspectPopupOwned(t, m, body.Scene); len(p) != 0 {
++		t.Fatal("old callback opened help before the new deadline", p)
++	}
++	clock.Advance(TimingSettings.LongHoverTime + time.Millisecond)
++	drainManual(t, m)
++	if p := inspectPopupOwned(t, m, body.Scene); len(p) != 1 || p[0].Type != TooltipStage {
++		t.Fatal("current hover lost help", p)
++	}
++	if field.Text() != "Unchanged" {
++		t.Fatal("hover changed field text")
++	}
++	// MouseDown retains its usual dismissal behavior too.
++	inputManual(t, m, ManualInput{Type: events.MouseDown, Button: events.Left, Position: image.Pt(390, 250)})
++	drainManual(t, m)
++	if p := inspectPopupOwned(t, m, body.Scene); len(p) != 0 {
++		t.Fatal("press no longer dismisses help", p)
++	}
++}
