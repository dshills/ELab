+	}
+	before := inspect()
+	if len(before) != 2 || before[0].Type != core.TooltipStage || before[1].Type != core.MenuStage {
+		t.Fatal("tooltip/menu precondition missing", before)
+	}
+	if err := a.Do(func() { sibling = false; _ = a.Invalidate("one") }); err != nil {
