+
+// SupportsControlStateKey reports the ordinary controls whose local native state
+// can be replaced independently of their public IDs. It excludes caller-owned
+// model bindings and containers; keys do not propagate to descendants.
+func SupportsControlStateKey(kind Kind) bool {
+	switch kind {
+	case Button, Checkbox, Switch, ToggleButton, Selector, Slider, NumberField,
+		TextField, RadioGroup, SegmentedControl, ListBox, MenuButton:
+		return true
+	default:
+		return false
+	}
+}
