+func TestNumberFieldDecimalStepsKeepTextAndValueConsistent(t *testing.T) {
+	for _, tc := range []struct {
+		name                          string
+		value, minimum, maximum, step float32
+		keys                          []key.Codes
+		values                        []float32
+		text                          []string
+	}{
