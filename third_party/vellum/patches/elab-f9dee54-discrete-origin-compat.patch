+			if spinner.Min != tc.minimum || spinner.Max != tc.maximum || spinner.Step != tc.step || spinner.EnforceStep {
+				t.Fatal("stepping changed configured bounds or off-grid policy")
+			}
+		})
+	}
+}
+
+func TestCompactNumberFieldDecimalStepsAndClampedBounds(t *testing.T) {
+	for _, tc := range []struct {
+		name                          string
+		value, minimum, maximum, step float32
+		keys                          []key.Codes
+		values                        []float32
+		text                          []string
+	}{
+		{"repeated", .03, 0, 1, .001, []key.Codes{key.CodeUpArrow, key.CodeUpArrow, key.CodeDownArrow, key.CodeDownArrow}, []float32{.031, .032, .031, .03}, []string{"0.031", "0.032", "0.031", "0.03"}},
+		{"off-grid", .0305, 0, 1, .001, []key.Codes{key.CodeUpArrow, key.CodeDownArrow}, []float32{.0315, .0305}, []string{"0.0315", "0.0305"}},
+		{"negative", -.03, -1, 1, .001, []key.Codes{key.CodeDownArrow, key.CodeDownArrow}, []float32{-.031, -.032}, []string{"-0.031", "-0.032"}},
+		{"upper-clamp", .031, .001, .0315, .001, []key.Codes{key.CodeUpArrow, key.CodeUpArrow}, []float32{.0315, .0315}, []string{"0.0315", "0.0315"}},
+		{"lower-clamp", .001, .001, .0315, .001, []key.Codes{key.CodeDownArrow}, []float32{.001}, []string{"0.001"}},
+		{"page", .03, 0, 1, .001, []key.Codes{key.CodePageUp, key.CodePageDown}, []float32{.04, .03}, []string{"0.04", "0.03"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			number, calls := tc.value, 0
+			m, _ := simpleManual(t, manualConfig(t, 7), func() ui.Node {
+				return ui.Node{ID: "root", Kind: ui.Column, Focus: ui.FocusRequest{ID: "number", Sequence: 1}, Children: []ui.Node{
+					{ID: "number", Kind: ui.NumberField, Number: number, NumberButtons: ui.NumberButtonsStepper,
+						Numeric: ui.Numeric{Min: tc.minimum, Max: tc.maximum, Step: tc.step}, Change: func(e ui.ChangeEvent) { number = e.Number; calls++ }},
+				}}
+			})
+			unitSettle(t, m)
+			w := m.implementation.find("one")
+			spinner := findRecord(w.state.root, "number").widget.(*core.Spinner)
+			for i, code := range tc.keys {
+				if err := m.Input(testContext, ManualInput{Window: "one", WindowIncarnation: w.incarnation, Type: events.KeyChord, Code: code}); err != nil {
+					t.Fatal(err)
+				}
+				unitSettle(t, m)
+				// Native keyboard stepping emits Change even when its boundary
+				// clamp leaves the value unchanged; retain that existing policy.
+				if number != tc.values[i] || spinner.Value != number || spinner.EditingState().Text != tc.text[i] || calls != i+1 {
+					t.Fatalf("step %d: accepted=%g native=%g text=%q calls=%d, want %g/%q/%d", i, number, spinner.Value, spinner.EditingState().Text, calls, tc.values[i], tc.text[i], i+1)
+				}
+			}
+			if spinner.EnforceStep || spinner.Min != tc.minimum || spinner.Max != tc.maximum || spinner.Step != tc.step {
+				t.Fatal("compact stepping changed the bounds or off-grid entry policy")
+			}
+		})
+	}
+}
