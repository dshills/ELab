++// Common macOS cursors use OS-owned artwork and accessibility sizing. Custom
++// enums and shapes without a portable standard counterpart retain raster cursors.
++func systemCursorShape(cursor enums.Enum) (glfw.StandardCursor, bool) {
++	c, ok := cursor.(cursors.Cursor)
++	if !ok {
++		return 0, false
++	}
++	switch c {
++	case cursors.None, cursors.Arrow:
++		return glfw.ArrowCursor, true
++	case cursors.Pointer:
++		return glfw.HandCursor, true
++	case cursors.Text:
++		return glfw.IBeamCursor, true
++	case cursors.Crosshair, cursors.Cell:
++		return glfw.CrosshairCursor, true
++	case cursors.ResizeCol, cursors.ResizeEW, cursors.ResizeE, cursors.ResizeW, cursors.ResizeLeft, cursors.ResizeRight:
++		return glfw.HResizeCursor, true
++	case cursors.ResizeRow, cursors.ResizeNS, cursors.ResizeN, cursors.ResizeS, cursors.ResizeUp, cursors.ResizeDown:
++		return glfw.VResizeCursor, true
++	}
++	return 0, false
++}
++
++// Native-main-only, bounded to the six admitted standard shapes. Handles are
++// registered before binding so terminal cleanup also owns a failed assignment.
++type systemCursorOwner struct {
++	handles map[glfw.StandardCursor]any
++	create  func(glfw.StandardCursor) (any, error)
++	bind    func(any)
++	destroy func(any)
++	closed  bool
++}
++
++func (o *systemCursorOwner) apply(shape glfw.StandardCursor) error {
++	if o.closed {
++		return fmt.Errorf("desktop: standard cursor closed")
++	}
++	switch shape {
++	case glfw.ArrowCursor, glfw.HandCursor, glfw.IBeamCursor, glfw.CrosshairCursor, glfw.HResizeCursor, glfw.VResizeCursor:
++	default:
++		return fmt.Errorf("desktop: unsupported standard cursor")
++	}
++	h := o.handles[shape]
++	if h == nil {
++		var err error
++		h, err = o.create(shape)
++		if err != nil {
++			return err
++		}
++		if h == nil {
++			return fmt.Errorf("desktop: standard cursor allocation refused")
++		}
++		o.handles[shape] = h
++	}
++	o.bind(h)
++	return nil
++}
++func (o *systemCursorOwner) close() {
++	if o.closed {
++		return
++	}
++	o.closed = true
++	fs := []func(){func() { o.bind(nil) }}
++	for shape, h := range o.handles {
++		delete(o.handles, shape)
++		handle := h
++		fs = append(fs, func() { o.destroy(handle) })
++	}
++	defer func() { o.handles = nil; o.create = nil; o.bind = nil; o.destroy = nil }()
++	drainAll(fs...)
++}
