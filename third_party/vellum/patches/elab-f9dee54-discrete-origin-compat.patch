++		cu.appliedSequence != 0 && cu.appliedSequence == seq-1 && cu.appliedStandard == shape &&
++		cu.modeSequence == 0 && cu.modeKnown && cu.mode == glfw.CursorNormal && cu.wantEnabled && !cu.wantRaw &&
++		!w.IsClosed() && !a.MainStopped()
