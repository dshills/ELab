++package core
++
++import "cogentcore.org/core/tree"
++
++// CloseTooltips closes only tooltip popups originating in this widget's subtree.
++// Call before detaching/deleting the subtree, while its scene and ancestry still
++// exist, with the originating render context held. Menus and other widgets'
++// tooltips are preserved. It invokes no input or value-change handlers.
++func (wb *WidgetBase) CloseTooltips() {
++	if wb.Scene == nil || wb.Scene.Stage == nil || wb.Scene.Stage.popups == nil {
++		return
++	}
++	stack := wb.Scene.Stage.popups
++	var owned []*Stage
++	stack.Lock()
++	for _, entry := range stack.stack.Order {
++		stage := entry.Value
++		if stage.Type != TooltipStage {
++			continue
++		}
++		for context := stage.Context; !tree.IsNil(context); {
++			if context.AsWidget() == wb {
++				owned = append(owned, stage)
++				break
++			}
++			parent, ok := context.AsTree().Parent.(Widget)
++			if !ok {
++				break
++			}
++			context = parent
++		}
++	}
++	stack.Unlock()
++	// Popup deletion takes the stack lock and destroys its scene. Do that only
++	// after releasing the inspection lock, and close the exact owned stage.
++	for _, stage := range owned {
++		stage.ClosePopup()
++	}
++}
