new file mode 100644
index 0000000..d637515
--- /dev/null
+++ b/drivers/cogent/numberfield_step.go
@@ -0,0 +1,44 @@
+package cogent
+
+import (
+	"math/big"
+	"strconv"
+
+	"cogentcore.org/core/core"
+)
+
+// Step the displayed decimal values, then round once to the native float32.
+// Repeated binary addition otherwise turns 0.03 + 0.001 + 0.001 into
+// 0.031999998. Keep the accepted value and its round-trip text consistent;
+// lowering display precision alone can hide a different stored value.
+func managedNumberStep(spinner *core.Spinner, steps float32) float32 {
+	result := decimalNumberStep(spinner.Value, spinner.Step, steps)
+	// StepFunc replaces the native wrap path. Preserve its existing behavior;
+	// SetValue still owns the bounds and full-precision value-to-text update.
+	if spinner.HasMin && spinner.HasMax {
+		if result < spinner.Min {
+			return spinner.Max
+		}
+		if result > spinner.Max {
+			return spinner.Min
+		}
+	}
+	return result
+}
+
+// Share decimal addition with compact steppers, whose boundary policy clamps
+// rather than wraps. Typed off-grid values keep their precision and offset.
+func decimalNumberStep(current, increment, steps float32) float32 {
+	decimal := func(value float32) (*big.Rat, bool) {
+		return new(big.Rat).SetString(strconv.FormatFloat(float64(value), 'g', -1, 32))
+	}
+	value, valueOK := decimal(current)
+	step, stepOK := decimal(increment)
+	count, countOK := decimal(steps)
+	result := current + steps*increment
+	if valueOK && stepOK && countOK {
+		value.Add(value, step.Mul(step, count))
+		result, _ = value.Float32()
+	}
+	return result
+}
