+//go:build offscreen
+
+package cogent
+
+import (
+	"fmt"
+	"testing"
+
+	"cogentcore.org/core/core"
+	"cogentcore.org/core/events"
+	"cogentcore.org/core/events/key"
+	"cogentcore.org/core/math32"
+	"github.com/dshills/vellum/ui"
+)
+
+func TestNumberFieldWheelPreservesValueAndDraft(t *testing.T) {
+	for _, scrolling := range []bool{false, true} {
+		t.Run(fmt.Sprintf("scroll-parent=%t", scrolling), func(t *testing.T) {
+			number, calls := float32(25), 0
+			m, _ := simpleManual(t, manualConfig(t, 7), func() ui.Node {
+				children := []ui.Node{
+					{ID: "number", Kind: ui.NumberField, Number: number, MinHeight: 40, Numeric: ui.Numeric{Min: 0, Max: 100, Step: 1}, Change: func(e ui.ChangeEvent) { number = e.Number; calls++ }},
+					{ID: "witness", Kind: ui.Label, Text: "Following controls", MinHeight: 32},
+				}
+				if scrolling {
+					for i := range 16 {
+						children = append(children, ui.Node{ID: fmt.Sprintf("padding-%d", i), Kind: ui.Label, Text: "Further controls", MinHeight: 32})
+					}
+					children = []ui.Node{{ID: "scroll", Kind: ui.Scroll, Grow: true, Children: []ui.Node{{ID: "content", Kind: ui.Column, Children: children}}}}
+				}
+				return ui.Node{ID: "root", Kind: ui.Column, Grow: true, Focus: ui.FocusRequest{ID: "number", Sequence: 1}, Children: children}
+			})
+			unitSettle(t, m)
+			w := m.implementation.find("one")
+			send := func(input ManualInput) {
+				t.Helper()
+				input.Window, input.WindowIncarnation = "one", w.incarnation
+				if err := m.Input(testContext, input); err != nil {
+					t.Fatal(err)
+				}
+				unitSettle(t, m)
+			}
+			snapshot, err := m.Snapshot(testContext)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if snapshot.Windows[0].FocusedID != "number" {
+				t.Fatal("number field did not receive actual focus")
+			}
+			spinner := findRecord(w.state.root, "number").widget.(*core.Spinner)
+			// A private unfinished entry must not be submitted or replaced by a wheel.
+			send(ManualInput{Type: events.KeyChord, Rune: '9'})
+			draft := spinner.EditingState()
+			if draft.Text == "25" || number != 25 || calls != 0 {
+				t.Fatal("fixture did not retain a private unfinished edit", draft, number, calls)
+			}
+			before := findRecord(w.state.root, "witness").widget.AsWidget().Geom.TotalBBox
+			box := spinner.Geom.TotalBBox
+			send(ManualInput{Type: events.Scroll, Position: box.Min.Add(box.Size().Div(2)), Delta: math32.Vec2(0, 12)})
+			afterDraft := spinner.EditingState()
+			// The caret rectangle moves with a scrolling pane; logical text and
+			// selection must remain unchanged.
+			afterDraft.Caret = draft.Caret
+			if number != 25 || calls != 0 || afterDraft != draft {
+				t.Fatal("wheel changed the number or its private draft", number, calls, draft, spinner.EditingState())
+			}
+			if scrolling {
+				after := findRecord(w.state.root, "witness").widget.AsWidget().Geom.TotalBBox
+				if after.Min.Y >= before.Min.Y {
+					t.Fatal("wheel did not reach the enclosing scroll pane", before, after)
+				}
+			}
+			// Only the wheel behavior changes; ordinary explicit editing still works.
+			send(ManualInput{Type: events.KeyChord, Code: key.CodeEscape})
+			send(ManualInput{Type: events.KeyChord, Code: key.CodeUpArrow})
+			if number != 26 || calls != 1 {
+				t.Fatal("Up did not step once after wheel", number, calls)
+			}
+			send(ManualInput{Type: events.KeyChord, Code: key.CodeDownArrow})
+			if number != 25 || calls != 2 {
+				t.Fatal("Down did not step once after wheel", number, calls)
+			}
+		})
+	}
+}
