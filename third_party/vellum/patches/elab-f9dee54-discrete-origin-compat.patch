++		cu.appliedSequence = seq
++		cu.Cur = cursor
++	}
++	cu.mu.Unlock()
++	if unchanged {
++		return nil
++	}
++	err := base.ErrMainStopped
++	a.nativeOnMain(func() {
++		cu.mu.Lock()
++		valid := !cu.closed && cu.sequence == seq && cu.window == w && cu.app == a
++		cu.mu.Unlock()
++		if !valid || w.Glw == nil {
++			err = fmt.Errorf("desktop: cursor request retired")
++			return
++		}
++		err = cu.standard.apply(shape)
++		if err != nil {
++			return
++		}
++		// A later raster request must rebind even when its raster handle is cached.
++		cu.owner.active = nil
++		cu.mu.Lock()
++		if !cu.closed {
++			cu.Cur = cursor
++			cu.appliedKey = nativeCursorKey{}
++			cu.appliedSequence, cu.appliedStandard = seq, shape
++			cu.appliedScale, cu.appliedPixels = 0, 0
++		}
++		cu.mu.Unlock()
++	})
++	return err
++}
