+	w.body.AsyncUnlock()
+	unitSettle(t, m)
+	inspect := func() []core.PopupInspection {
+		w.body.AsyncLock()
+		defer w.body.AsyncUnlock()
+		popups, err := w.body.Scene.InspectPopups(8192, 8<<20)
+		if err != nil {
+			t.Fatal(err)
+		}
