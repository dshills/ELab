        {
          "code": "not-ready",
          "phase": "admission",
          "when": "Either capture is unavailable or incomplete"
        },
        {
          "code": "conflict",
          "phase": "admission",
          "when": "Set command names a changed selected recording"
        }
      ],
      "completion": {
        "mode": "bounded immediate in-memory comparison; no worker or file IO",
        "observe": [
          "recording.compare",
          "project.inspect"
        ],
        "cancel": "",
        "cooperative_deadline_s": 0
      }
    },
