      "additionalProperties": false,
      "examples": [
        {}
      ],
      "properties": {
        "capacitor_initials": {
          "description": "Unique current capacitor IDs. Scenario voltages are pin 1 minus pin 2, signed \u00b112 V. Empty array clears the list; null is refused. Start omission inherits stored list; full settings requires an array.",
          "items": {
            "additionalProperties": false,
