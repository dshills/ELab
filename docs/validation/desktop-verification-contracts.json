    "verification.settings.set": {
      "additionalProperties": false,
      "examples": [
        {
          "duration_s": 0.1,
          "sample_step_s": 0,
          "input_mode": "auto",
          "capacitor_initials": []
        }
      ],
      "properties": {
        "capacitor_initials": {
          "description": "Unique current capacitor IDs. Scenario voltages are pin 1 minus pin 2, signed \u00b112 V. Empty array clears the list; null is refused. Start omission inherits stored list; full settings requires an array.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Current snapshot.components entry with kind capacitor.",
                "type": "string"
              },
              "voltage_v": {
                "maximum": 12,
                "minimum": -12,
                "type": "number",
                "x-unit": "V"
              }
            },
            "required": [
              "id",
              "voltage_v"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 0,
          "type": "array",
          "x-unique-by": "id"
        },
        "duration_s": {
          "$ref": "urn:elab:time:1",
          "x-normalized-si-range": {
            "maximum": 10,
            "minimum": 0
          },
          "x-unit": "s"
        },
        "initial_voltage_v": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Global startup default 0\u201312 V; graph per-capacitor settings and scenario overrides take precedence. Start omitted/null inherits defaults; full settings omitted/null clears this override.",
          "x-unit": "V"
        },
        "input_mode": {
          "enum": [
            "auto",
            "charge",
            "discharge",
            "high",
            "low"
          ],
          "type": "string"
        },
        "sample_step_s": {
          "$ref": "urn:elab:time:1",
          "description": "Omitted/null start override inherits stored defaults; effective zero follows current project step. Nonzero step 1 \u00b5s\u20131 s. Offline Verify does not impose playback-rate bounds.",
          "x-normalized-si-alternatives": [
            {
              "const": 0
            },
            {
              "maximum": 1,
              "minimum": 1e-06
            }
          ],
          "x-unit": "s"
        }
      },
      "required": [
        "duration_s",
        "sample_step_s",
        "input_mode",
        "capacitor_initials"
      ],
      "type": "object",
      "x-command-contract": {
        "version": 1,
        "scope": "verification-and-retained-operation-commands",
        "preconditions": [
          "Ranges and current capacitor identities are valid; incomplete graphs and mode/analysis combinations may be configured before running"
        ],
        "effects": [
          "Preserves live graph, physics/time, pause/held inputs, simulation settings and edit history",
          "Replaces session-only defaults; does not start work or mark the document dirty; omission/null global startup clears it"
        ],
        "errors": [
          {
            "code": "invalid-params",
            "phase": "admission",
            "when": "Malformed input or an invalid parameter/relationship"
          }
        ],
        "completion": {
          "mode": "immediate in-memory result",
          "observe": null,
          "cancel": "",
          "cooperative_deadline_s": 0
        }
      },
      "x-input-mode-inventory": "snapshot.verification_input_modes for current analysis; stored defaults may be configured in advance",
      "x-max-retained-operations": 8,
      "x-operation-inventory": "snapshot.operations (time/DC verification and imported/project recordings; not DC sweeps)",
      "x-startup-precedence": [
        "scenario capacitor_initials",
        "saved component initial_voltage_v",
        "scenario/stored global initial_voltage_v",
        "project experiment initial_voltage_v"
      ]
