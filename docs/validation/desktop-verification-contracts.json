              "voltage_v"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 0,
          "type": "array",
          "x-unique-by": "id"
        },
        "duration_s": {
          "anyOf": [
            {
              "$ref": "urn:elab:time:1"
            },
            {
              "type": "null"
            }
          ],
          "x-normalized-si-range": {
            "maximum": 10,
            "minimum": 0
          },
          "x-unit": "s"
        },
        "initial_voltage_v": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Global startup default 0\u201312 V; graph per-capacitor settings and scenario overrides take precedence. Start omitted/null inherits defaults; full settings omitted/null clears this override.",
          "x-unit": "V"
        },
        "input_mode": {
          "description": "Omitted, null or empty inherits stored input mode. Admission requires membership in snapshot.verification_input_modes; auto uses configured source waveforms, not live elapsed phase.",
          "enum": [
            "",
            null,
            "auto",
            "charge",
            "discharge",
            "high",
            "low"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "probe_ids": {
          "description": "Omit for current selected live probes (with DC fallback channels). Explicit [] captures no channels; null is refused. IDs must be unique current probe inventory entries.",
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "sample_step_s": {
          "anyOf": [
            {
              "$ref": "urn:elab:time:1"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omitted/null start override inherits stored defaults; effective zero follows current project step. Nonzero step 1 \u00b5s\u20131 s. Offline Verify does not impose playback-rate bounds.",
          "x-normalized-si-alternatives": [
            {
              "const": 0
            },
            {
              "maximum": 1,
              "minimum": 1e-06
            }
          ],
          "x-unit": "s"
        }
      },
      "required": [],
      "type": "object",
      "x-command-contract": {
        "version": 1,
        "scope": "verification-and-retained-operation-commands",
        "preconditions": [
          "Complete supported current graph; stored defaults plus non-null overrides satisfy analysis/startup/mode rules",
          "At most one active verification, including canceling; a recording slot is free or an excluded terminal operation is evictable",
          "Transient duration positive and \u226410 s; ceil(duration/effective step) \u22641000; DC is one operating point at zero",
          "Current mode inventory: RC auto/charge/discharge; other supported transient families auto/high/low; DC auto only"
        ],
        "effects": [
          "Preserves live graph, physics/time, pause/held inputs, simulation settings and edit history",
          "Captures graph/models/startup/settings/probes and clears prior recorded comparison/timing selection; publishes only a complete successful recording, kept by default",
          "Later source edits do not alter the captured input; admission does not imply solve success or frame-budget completion"
        ],
        "errors": [
          {
            "code": "invalid-params",
            "phase": "admission",
            "when": "Malformed input or an invalid parameter/relationship"
          },
          {
            "code": "busy",
            "phase": "admission",
            "when": "A verification is queued/running/canceling"
          },
          {
            "code": "record-limit",
            "phase": "admission",
            "when": "Eight retained operations are kept or active"
          },
          {
            "code": "unavailable",
            "phase": "admission",
            "when": "Current circuit is incomplete or unsupported"
          },
          {
            "code": "timeout",
            "phase": "operation",
            "when": "Cooperative 30-second wall deadline expires"
          },
          {
            "code": "solve-failed",
            "phase": "operation",
            "when": "Kernel or recorded-frame bound fails; typed integration errors can report their existing specific codes"
          }
        ],
        "completion": {
          "mode": "immediate operation admission; inspect until terminal",
          "observe": [
            "operation.inspect",
            "project.inspect",
            "events.poll"
          ],
          "cancel": "operation.cancel",
          "cooperative_deadline_s": 30
        }
      },
      "x-input-mode-inventory": "snapshot.verification_input_modes for current analysis; stored defaults may be configured in advance",
      "x-max-output-steps": 1000,
      "x-max-recorded-frames": 4096,
      "x-max-retained-operations": 8,
      "x-normalized-si-relations": [
        {
          "limit": 1000,
          "operator": "ceil(duration_s/effective_sample_step_s)<=limit"
        },
        {
          "omitted_dc_duration": "zero even if stored duration is positive",
          "operator": "duration_s>0 for transient; explicit duration_s==0 for DC"
        },
        {
          "operator": "effective step <= project high_s and low_s when graph includes ideal pulse-source"
        },
        {
          "operator": "no global/per-capacitor startup overrides for DC"
        }
      ],
      "x-operation-inventory": "snapshot.operations (time/DC verification and imported/project recordings; not DC sweeps)",
      "x-probe-inventory": "snapshot.scope.available; captured order is retained in metadata and row values",
      "x-startup-precedence": [
        "scenario capacitor_initials",
        "saved component initial_voltage_v",
        "scenario/stored global initial_voltage_v",
        "project experiment initial_voltage_v"
      ]
    },
