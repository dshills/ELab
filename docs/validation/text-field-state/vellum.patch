diff --git a/ui/text_state_key_test.go b/ui/text_state_key_test.go
new file mode 100644
index 0000000..3d92573
--- /dev/null
+++ b/ui/text_state_key_test.go
@@ -0,0 +1,20 @@
+package ui
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestTextStateKeyRequiresManagedTextField(t *testing.T) {
+	for _, kind := range []Kind{TextField, Label, Button, NumberField, MultilineText} {
+		n := Node{ID: "field", Kind: kind, TextStateKey: "document:part"}
+		err := Validate(n)
+		if kind == TextField {
+			if err != nil {
+				t.Fatal(err)
+			}
+		} else if err == nil || !strings.Contains(err.Error(), "TextStateKey") {
+			t.Fatalf("kind=%s must reject the text-only key: %v", kind, err)
+		}
+	}
+}
