 	Icon Symbol
@@ -106,6 +112,9 @@ func Validate(root Node) error {
 		if n.ID == "" || seen[n.ID] {
 			return fmt.Errorf("ui: empty or duplicate ID %q", n.ID)
 		}
+		if n.TextStateKey != "" && n.Kind != TextField {
+			return fmt.Errorf("ui: node %q: TextStateKey requires TextField", n.ID)
+		}
 		if strings.HasPrefix(n.ID, "canvas-object:") {
