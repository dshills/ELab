++	where := w.mouseEventPosPoint(gw)
+--- /dev/null
++++ b/system/driver/desktop/mouse_position_vellum_test.go
+@@ -0,0 +1,52 @@
++package desktop
++
++import (
++	"image"
++	"testing"
++)
++
++type mousePositionAttachment struct {
++	point image.Point
++	valid bool
++	calls int
++}
++
++type passiveMouseAttachment struct{}
++
++func (*passiveMouseAttachment) Focus(bool) {}
++func (*passiveMouseAttachment) Close()     {}
++
++func (*mousePositionAttachment) Focus(bool) {}
++func (*mousePositionAttachment) Close()     {}
++func (a *mousePositionAttachment) MouseEventPosition() (image.Point, bool) {
++	a.calls++
++	return a.point, a.valid
++}
++
++func TestNativeMouseEventPositionPrecedesHardwarePolling(t *testing.T) {
++	a := &mousePositionAttachment{point: image.Pt(1949, -37), valid: true}
++	w := &Window{Native: a}
++	w.DevicePixelRatio = 2 // A native point is already scaled; do not scale twice.
++	// A nil GLFW window would panic if hardware polling preceded admission.
++	if got := w.mouseEventPosPoint(nil); got != a.point || a.calls != 1 {
++		t.Fatal("native device-pixel event lost", got, a.calls)
++	}
++	a.point = image.Pt(-4, 1000)
++	if got := w.mouseEventPosPoint(nil); got != a.point || a.calls != 2 {
++		t.Fatal("event position was cached or clamped", got, a.calls)
++	}
++}
++
++func TestNativeMouseEventPositionWindowAndFallbackIsolation(t *testing.T) {
++	first := &Window{Native: &mousePositionAttachment{point: image.Pt(10, 20), valid: true}}
++	second := &Window{Native: &mousePositionAttachment{point: image.Pt(30, 40), valid: true}}
++	if first.mouseEventPosPoint(nil) != image.Pt(10, 20) || second.mouseEventPosPoint(nil) != image.Pt(30, 40) {
++		t.Fatal("native event crossed window attachments")
++	}
++	for _, native := range []NativeAttachment{nil, &passiveMouseAttachment{}, &mousePositionAttachment{point: image.Pt(1, 2), valid: false}} {
++		w := &Window{Native: native}
++		if _, ok := w.nativeMouseEventPosition(); ok {
++			t.Fatalf("unavailable event prevented hardware fallback: %T", native)
++		}
++	}
++}
