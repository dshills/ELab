diff --git a/drivers/cogent/mouse_position_darwin.go b/drivers/cogent/mouse_position_darwin.go
new file mode 100644
index 0000000..096b815
--- /dev/null
+++ b/drivers/cogent/mouse_position_darwin.go
@@ -0,0 +1,26 @@
+//go:build darwin && cgo
+
+package cogent
+
+/*
+#cgo darwin CFLAGS: -fobjc-arc
+#cgo darwin LDFLAGS: -framework Cocoa
+int vellumNativeMouseEventPosition(void *window, double *x, double *y);
+*/
+import "C"
+
+import "image"
+
+// GLFW mouse-button/scroll callbacks can carry a queued event at a position
+// different from the hardware cursor. Keep window matching and conversion on
+// the native thread; this hook does not post work or inspect UI-owned records.
+func (n *accessibilityAttachment) MouseEventPosition() (image.Point, bool) {
+	if n == nil || n.window == nil || n.window.Glw == nil {
+		return image.Point{}, false
+	}
+	var x, y C.double
+	if C.vellumNativeMouseEventPosition(n.window.Glw.GetCocoaWindow(), &x, &y) == 0 {
+		return image.Point{}, false
+	}
+	return n.window.MousePosToPoint(float64(x), float64(y)), true
+}
diff --git a/drivers/cogent/mouse_position_darwin.m b/drivers/cogent/mouse_position_darwin.m
new file mode 100644
index 0000000..bc51e94
--- /dev/null
+++ b/drivers/cogent/mouse_position_darwin.m
@@ -0,0 +1,37 @@
+//go:build darwin && cgo
+
+#import <Cocoa/Cocoa.h>
+#include <math.h>
+
+// No mouse position is cached: only this window's current mouse event can
+// replace hardware polling. Coordinates remain outside the view during drags.
+static int vellumMouseEventPosition(NSWindow *window, NSEvent *event,
+                                   double *x, double *y) {
+    if (![NSThread isMainThread] || !window || !event || !x || !y ||
+        event.window != window) return 0;
+    switch (event.type) {
+        case NSEventTypeLeftMouseDown: case NSEventTypeLeftMouseUp:
+        case NSEventTypeRightMouseDown: case NSEventTypeRightMouseUp:
+        case NSEventTypeOtherMouseDown: case NSEventTypeOtherMouseUp:
+        case NSEventTypeLeftMouseDragged: case NSEventTypeRightMouseDragged:
+        case NSEventTypeOtherMouseDragged: case NSEventTypeMouseMoved:
+        case NSEventTypeScrollWheel: break;
+        default: return 0;
+    }
+    NSView *view = window.contentView;
+    if (!view) return 0;
+    NSPoint point = [view convertPoint:event.locationInWindow fromView:nil];
+    NSRect bounds = view.bounds;
+    double left = point.x - NSMinX(bounds);
+    double top = view.isFlipped ? point.y - NSMinY(bounds) : NSMaxY(bounds) - point.y;
+    if (!isfinite(left) || !isfinite(top)) return 0;
+    *x = left;
+    *y = top;
+    return 1;
+}
+
+int vellumNativeMouseEventPosition(void *rawWindow, double *x, double *y) {
+    if (![NSThread isMainThread] || !rawWindow) return 0;
+    return vellumMouseEventPosition((__bridge NSWindow *)rawWindow,
+                                    [NSApp currentEvent], x, y);
+}
