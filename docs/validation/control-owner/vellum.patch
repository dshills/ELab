@@ -41,6 +41,13 @@ type Node struct {
 	// Other kinds must leave this empty; caller-owned editor/grid/tree models
 	// already provide their own identity contracts.
 	TextStateKey string
+	// ControlStateKey identifies the logical owner of a simple managed control's
+	// local editing, selection or pressed state. Changing it remounts the control
+	// without changing its public ID. Empty retains ordinary ID/kind behavior.
+	// Use SupportsControlStateKey to distinguish these controls from caller-owned
+	// editor/grid/tree models, which retain their separate identity contracts.
+	// Placement-bound controls must also leave this empty.
+	ControlStateKey string
 	// Icon is bundled artwork for Icon/Button/ToggleButton. Text is alternate
 	// text for an Icon. Icon-only actions require Accessibility.Name.
 	Icon Symbol
@@ -112,6 +119,9 @@ func Validate(root Node) error {
 		if n.ID == "" || seen[n.ID] {
 			return fmt.Errorf("ui: empty or duplicate ID %q", n.ID)
 		}
+		if n.ControlStateKey != "" && (!SupportsControlStateKey(n.Kind) || n.PlacementSource != nil || n.PlacementTarget != nil) {
+			return fmt.Errorf("ui: node %q: ControlStateKey requires a simple managed control", n.ID)
+		}
 		if n.TextStateKey != "" && n.Kind != TextField {
 			return fmt.Errorf("ui: node %q: TextStateKey requires TextField", n.ID)
 		}
@@ -203,3 +213,16 @@ func Validate(root Node) error {
 	}
 	return nil
 }
+
+// SupportsControlStateKey reports the ordinary controls whose local native state
+// can be replaced independently of their public IDs. It excludes caller-owned
+// model bindings and containers; keys do not propagate to descendants.
+func SupportsControlStateKey(kind Kind) bool {
+	switch kind {
+	case Button, Checkbox, Switch, ToggleButton, Selector, Slider, NumberField,
+		TextField, RadioGroup, SegmentedControl, ListBox, MenuButton:
+		return true
+	default:
+		return false
+	}
+}
