diff --git a/ui/control_state_key_test.go b/ui/control_state_key_test.go
new file mode 100644
index 0000000..f0b5c6c
--- /dev/null
+++ b/ui/control_state_key_test.go
@@ -0,0 +1,36 @@
+package ui
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/dshills/vellum/placement"
+)
+
+func TestControlStateKeyRequiresSimpleControl(t *testing.T) {
+	for _, kind := range []Kind{Button, Checkbox, Switch, ToggleButton, Selector, Slider, NumberField, TextField, RadioGroup, SegmentedControl, ListBox, MenuButton, Label, Column, DataGrid, DataTree, MultilineText} {
+		n := Node{ID: "control", Kind: kind, ControlStateKey: "doc:part", Numeric: Numeric{Min: 0, Max: 100, Step: 1}, Options: []Option{{ID: "one", Label: "One"}}, SelectedID: "one", Activate: func() {}, Change: func(ChangeEvent) {}}
+		if kind == ListBox || kind == MenuButton {
+			n.Activate = nil
+		}
+		if kind == MenuButton {
+			n.SelectedID = ""
+			n.Text = "Actions"
+		}
+		err := Validate(n)
+		if SupportsControlStateKey(kind) {
+			if err != nil {
+				t.Fatalf("supported kind %s: %v", kind, err)
+			}
+		} else if err == nil || !strings.Contains(err.Error(), "ControlStateKey") {
+			t.Fatalf("kind=%s must refuse unsupported state key: %v", kind, err)
+		}
+	}
+}
+
+func TestControlStateKeyRejectsPlacementModelBinding(t *testing.T) {
+	n := Node{ID: "source", Kind: Button, ControlStateKey: "owner", PlacementSource: &placement.Source{}}
+	if err := Validate(n); err == nil || !strings.Contains(err.Error(), "ControlStateKey") {
+		t.Fatalf("placement model must retain its established binding contract: %v", err)
+	}
+}
diff --git a/ui/node.go b/ui/node.go
index 0730e0e..80781ab 100644
--- a/ui/node.go
