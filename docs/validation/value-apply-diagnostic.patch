+package main
+
+import (
+	"cogentcore.org/core/core"
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/dshills/vellum/app"
+	"github.com/dshills/vellum/drivers/cogent"
+	"log"
+	"time"
+)
+
+func liveInspectorProbe(a *app.Application, s *screen) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-a.Context().Done():
+			return
+		case <-ticker.C:
+		}
+		if s.service.Snapshot().Selected != "RF" {
+			continue
+		}
+		ctx, cancel := context.WithTimeout(a.Context(), time.Second)
+		done := make(chan map[string]any, 1)
+		err := a.PostWait(ctx, func() {
+			var widgets []map[string]any
+			if s.drawing.widget != nil {
+				s.drawing.widget.Scene.WidgetWalkDown(func(w core.Widget, b *core.WidgetBase) bool {
+					switch b.Name {
+					case "value-entry", "apply-value", "inspector", "part-model-id":
+						widgets = append(widgets, map[string]any{"id": b.Name, "type": fmt.Sprintf("%T", w), "bbox": b.Geom.TotalBBox, "visible": b.IsVisible()})
+					}
+					return true
+				})
+			}
+			done <- map[string]any{"widgets": widgets, "focus_request": s.keyboardFocus}
+		})
+		if err != nil {
+			cancel()
+			continue
+		}
+		select {
+		case sample := <-done:
+			ax, e := cogent.InspectAccessibility(ctx, "main")
+			if e != nil {
+				sample["ax_error"] = e.Error()
+			} else {
+				var elements []cogent.AccessibilityElement
+				for _, e := range ax.Elements {
+					switch e.DomainID {
+					case "value-entry", "apply-value", "inspector", "part-model-id":
+						elements = append(elements, e)
+					}
+				}
+				sample["accessibility"] = elements
+				sample["ax_focused"] = ax.FocusedID
+			}
+			sample["event"] = "elab.inspector.live.probe"
+			b, _ := json.Marshal(sample)
+			log.Print(string(b))
+		case <-ctx.Done():
+		}
+		cancel()
+	}
+}
