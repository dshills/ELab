+package main
+
+import (
+	"cogentcore.org/core/core"
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/dshills/elab/workbench"
+	"github.com/dshills/vellum/app"
+	"github.com/dshills/vellum/canvas"
+	"github.com/dshills/vellum/drivers/cogent"
+	"log"
+	"time"
+)
+
+func nativeSmoke(a *app.Application, s *screen, _ *cogent.MeshCanvas, timeout time.Duration) error {
+	ctx, cancel := context.WithTimeout(a.Context(), timeout)
+	defer cancel()
+	done := make(chan error, 1)
+	if e := a.PostWait(ctx, func() {
+		for _, p := range []struct {
+			command string
+			params  any
+		}{{"example.load", workbench.ExampleLoadParams{ID: "opamp-inverting"}}, {"simulation.pause", struct{}{}}, {"scope.visibility.set", workbench.ScopeVisibilityParams{Visible: false}}} {
+			r := s.invoke(p.command, p.params)
+			if r.Error != nil {
+				done <- fmt.Errorf("%s: %s", p.command, r.Error.Message)
+				return
+			}
+		}
+		done <- nil
+	}); e != nil {
+		return e
+	}
+	if e := <-done; e != nil {
+		return e
+	}
+	if _, err := waitNativeViewport(ctx, a, s, func(st workbench.Snapshot) bool { return st.Selected == "U1" }); err != nil {
+		return err
+	}
+	if err := a.PostWait(ctx, func() {
+		r := s.invoke("component.select", workbench.IDParams{ID: "RF"})
+		if r.Error != nil {
+			done <- fmt.Errorf("select RF: %s", r.Error.Message)
+		} else {
+			done <- nil
+		}
+	}); err != nil {
+		return err
+	}
+	if err := <-done; err != nil {
+		return err
+	}
+	var nodes []map[string]any
+	_, e := waitNativeViewport(ctx, a, s, func(st workbench.Snapshot) bool {
+		if st.Selected != "RF" || s.drawing.widget == nil {
+			return false
+		}
+		nodes = nil
+		found := false
+		s.drawing.widget.Scene.WidgetWalkDown(func(w core.Widget, b *core.WidgetBase) bool {
+			switch b.Name {
+			case "value-entry", "apply-value", "inspector", "part-model-id", "sidebar", "sidebar-content", "selection-navigation", "presets", "r-1k":
+				var ancestors []map[string]any
+				for p := b.Parent; p != nil; {
+					pw, ok := p.(core.Widget)
+					if !ok {
+						break
+					}
+					pb := pw.AsWidget()
+					ancestors = append(ancestors, map[string]any{"name": pb.Name, "type": fmt.Sprintf("%T", p), "bbox": pb.Geom.TotalBBox, "visible": pb.IsVisible()})
+					p = pb.Parent
+				}
+				nodes = append(nodes, map[string]any{"name": b.Name, "type": fmt.Sprintf("%T", w), "bbox": b.Geom.TotalBBox, "alloc": b.Geom.Size.Alloc.Content, "actual": b.Geom.Size.Actual.Content, "visible": b.IsVisible(), "scene_nil": b.Scene == nil, "ancestors": ancestors})
+				found = found || b.Name == "value-entry"
+			}
+			return true
+		})
+		return found
+	})
+	if e != nil {
+		return e
+	}
+	ax, e := cogent.InspectAccessibility(ctx, "main")
+	if e != nil {
+		return e
+	}
+	var elements []cogent.AccessibilityElement
+	for _, p := range ax.Elements {
+		switch p.DomainID {
+		case "value-entry", "apply-value", "inspector", "part-model-id", "sidebar", "sidebar-content", "selection-navigation", "presets", "r-1k":
+			elements = append(elements, p)
+		}
+	}
+	b, _ := json.Marshal(map[string]any{"event": "elab.inspector.geometry.probe", "widgets": nodes, "accessibility": elements})
+	log.Print(string(b))
+	_ = canvas.Point{}
+	return nil
+}
