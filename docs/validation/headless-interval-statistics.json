    "recording.statistics": {
      "id": "recording.statistics",
      "description": "Time-weighted mean, RMS, AC ripple RMS and extrema of saved linear segments",
      "mutation": false,
      "input_schema": {
        "additionalProperties": false,
        "examples": [
          {
            "id": "verify-1",
            "probe_id": "v:C1",
            "start_s": 0.01,
            "end_s": 0.02
          }
        ],
        "properties": {
          "end_s": {
            "$ref": "urn:elab:time:1",
            "x-normalized-si-range": {
              "maximum": 10,
              "minimum": 0
            }
          },
          "id": {
            "type": "string"
          },
          "probe_id": {
            "description": "Exact captured probe ID; set-only empty ID clears with zero start/end.",
            "type": "string"
          },
          "start_s": {
            "$ref": "urn:elab:time:1",
            "x-normalized-si-range": {
              "maximum": 10,
              "minimum": 0
            }
          }
        },
        "required": [
          "id",
          "probe_id",
          "start_s",
          "end_s"
        ],
        "type": "object",
        "x-command-contract": {
          "version": 1,
          "scope": "captured-interval-statistics",
          "preconditions": [
            "Retained completed recording, captured probe, positive interval within duration; a DC point cannot define a time average",
            "Set ID must match selected capture; empty probe with zero interval clears"
          ],
          "effects": [
            "Piecewise-linear reconstruction of adjacent saved rows, clipped by interpolation at interval boundaries; zero-duration duplicate edge segments contribute no area",
            "Time mean is integral(v)/duration; RMS is sqrt(integral(v\u00b2)/duration); AC RMS integrates deviations from the interval time mean; SI unit follows captured probe",
            "Extrema and peak-to-peak include limits of positive-duration clipped segments; isolated zero-duration excursions do not contribute",
            "No assertion of periodicity, steady state, unseen peaks or exact analog waveform between saved samples; plot decimation and sample statistics are independent",
            "Query is pure. Set caches owned session/view results; selection/reopen clears; preserves live circuit/time/charge, history, document and saved recordings"
          ],
          "errors": [
            {
              "code": "invalid-params",
              "phase": "admission",
              "when": "Malformed/missing input, invalid interval/clear request, or result outside finite range"
            },
            {
              "code": "not-ready",
              "phase": "admission",
              "when": "Capture absent or incomplete"
            },
            {
              "code": "not-found",
              "phase": "admission",
              "when": "Probe not captured"
            },
            {
              "code": "unavailable",
              "phase": "admission",
              "when": "No positive-duration saved segments"
            },
            {
              "code": "conflict",
              "phase": "admission",
              "when": "Set names a changed selected capture"
            }
          ],
          "completion": {
            "mode": "bounded in-memory integration of at most 4096 saved rows; no worker or file IO",
            "observe": [
              "recording.statistics",
              "project.inspect"
            ],
            "cancel": "",
            "cooperative_deadline_s": 0
          }
        },
        "x-inventory": {
          "ids": "snapshot.operations with completed status",
          "probe_ids": "operation.inspect metadata.probes; captured units and references"
        },
        "x-max-recorded-frames": 4096,
        "x-relations": [
          {
            "except": "set-only empty probe with zero interval clears",
            "fields": [
              "id",
              "start_s",
              "end_s"
            ],
            "operator": "0<=start_s<end_s<=captured duration"
          }
        ]
      },
      "output": "Query result",
      "output_schema": {
        "$ref": "urn:elab:recording-statistics:1"
